# Mẫu biến môi trường — copy sang `.env` (không commit). plan.md mục 14.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-by-get_random_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Dev: localhost mọi cổng đã mở bằng regex trong settings/dev.py. Prod: liệt kê origin tường minh.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL 16)
DB_NAME=hpsv
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
# Port host cho web (8000 hay bị Docker Desktop chiếm → 8010)
WEB_PORT=8010

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=7

# Email — dev dùng console backend, prod phải set host thật
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@hpsv.local
# Bắt buộc False ở prod (config/settings/prod.py tự chặn nếu True)
PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=True

# Backup (pg_dump — ADM-08)
BACKUP_DIR=/backups

# Tùy chọn
SENTRY_DSN=

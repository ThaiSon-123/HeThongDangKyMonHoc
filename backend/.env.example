# Mẫu biến môi trường — copy sang `.env` (không commit). plan.md mục 14.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-by-get_random_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Dev: localhost mọi cổng đã mở bằng regex trong settings/dev.py. Prod: liệt kê origin tường minh.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL 16)
DB_NAME=hethongdangkymonhoc
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
# Port host cho web (8000 hay bị Docker Desktop chiếm → 8010)
WEB_PORT=8010

# Số reverse proxy tin cậy phía trước app: 0 khi gọi thẳng (dev), 1 khi sau nginx (prod mặc định).
NUM_PROXIES=0

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=7

# Email — dev dùng console backend, prod phải set host thật
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@hethongdangkymonhoc.local
# Bắt buộc False ở prod (config/settings/prod.py tự chặn nếu True)
PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=True

# Backup (pg_dump — ADM-08)
BACKUP_DIR=/backups

# VNPay sandbox — đăng ký http://sandbox.vnpayment.vn/devreg/ (key gửi qua email). KHÔNG commit key thật.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Địa chỉ backend mà điện thoại truy cập được (IP LAN hoặc ngrok)
VNPAY_RETURN_URL=http://localhost:8000/api/tuition/vnpay/return/
APP_RESULT_URL=http://localhost:8080/student/tuition/pay-result

# Tùy chọn
SENTRY_DSN=
